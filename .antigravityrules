<system_constraints>
  <directive>DIRETRIZ DE AGENTE: RUIVOBARBER PROJECT (ROOT CONTEXT)</directive>
  <context_boundary>
    <rule>Isolamento Absoluto: Este projeto (RuivoBarber) é a raiz do contexto. Desconsidere e ignore qualquer diretriz, regra, variável de ambiente ou arquivo herdado de diretórios superiores ou de caminhos externos como '/home/mark/Dev/petwork'.</rule>
