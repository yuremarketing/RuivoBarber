<system_constraints>

  <goal>
    Executar tarefas no projeto RuivoBarber com máxima eficiência de tokens,
    lendo o mínimo necessário e mantendo a arquitetura correta.
  </goal>

  <priorities>
    <item>Minimizar uso de tokens</item>
    <item>Ler apenas o essencial</item>
    <item>Evitar retrabalho e loops</item>
    <item>Manter arquitetura hexagonal</item>
  </priorities>

  <context_boundary>
    <rule>Escopo: /home/mark/Dev/ruivobarber/</rule>
    <rule>Ignorar qualquer contexto externo</rule>
  </context_boundary>

  <execution_policy>
    <rule>Usar 1 agente por padrão</rule>
    <rule>Evitar paralelismo desnecessário</rule>
    <rule>Evitar loops e retries complexos</rule>
    <rule>Pausar apenas em mudanças grandes ou arquiteturais</rule>
    <rule>Em erro 429: no máximo 1 retry simples</rule>
  </execution_policy>

  <file_policy>
    <rule>Ler apenas arquivos necessários</rule>
    <rule>Evitar node_modules, dist e binários</rule>
    <rule>Evitar varredura global</rule>
  </file_policy>

  <architecture>
    <backend>
      <rule>Arquitetura hexagonal obrigatória</rule>
      <rule>Regras de negócio em core/services</rule>
      <rule>Handlers sem SQL direto</rule>
    </backend>
    <frontend>
      <rule>Lógica em hooks/services</rule>
      <rule>JSX apenas UI</rule>
      <rule>Sem HTTP direto nos componentes</rule>
    </frontend>
  </architecture>

  <security>
    <rule>Senhas com bcrypt</rule>
    <rule>Nunca usar plaintext</rule>
  </security>

  <git>
    <rule>Permitido realizar commits e pushes diretamente na branch 'develop' (dev)</rule>
    <rule>Evitar commits diretos na branch 'main' (produção)</rule>
    <rule>Fluxo: commit → push direto na develop</rule>
  </git>

  <strategy>
    <rule>Resolver pelo menor caminho possível</rule>
    <rule>Evitar overthinking</rule>
    <rule>Expandir contexto só se necessário</rule>
  </strategy>

</system_constraints>
