    </architecture>
    <style>
      <rule>Nomenclatura: Variáveis, funções e arquivos devem ser nomeados em português (ex: listarClientes, cliente_service.go). Rotas da API REST devem ser inteiramente em minúsculo.</rule>
    </style>
  </coding_standards>
